# ─────────────────────────────────────────────────────────── GLAMCORE.PL
#
# Strona platformy GLAM: pliki statyczne z /srv/glam-www (katalog www/
# z repozytorium, bez deploy/, serwer/ i README.md) oraz zgłoszenia
# z formularza, które przyjmuje usługa glam-zgloszenia (127.0.0.1:3500,
# konto `glam`, dane w /opt/glam/dane). Nic z innych projektów.
#
# Plik leży w repozytorium GLAM (www/deploy/glam.caddy), a na serwerze
# w /etc/caddy/glam.caddy. Główny Caddyfile ma tylko jedną linię
# `import /etc/caddy/glam.caddy`. Zmiany wprowadzaj tutaj i wgrywaj przez
# www/deploy/wdroz.sh, nie edytuj kopii na serwerze.
#
# Plik glam-klucz.caddy istnieje TYLKO na serwerze (prawa 640 root:caddy): nagłówek
# z kluczem, który usługa sprawdza na trasach admina. Logowanie do /admin (formularz,
# sesja w ciasteczku, skrót hasła w /opt/glam/admin.haslo) obsługuje sama usługa.
#
# Bloki nazwane mają pierwszeństwo przed `https://` (domeny klienckie
# ResHouse), więc glamcore.pl nigdy nie trafi na aplikację stron.

glamcore.pl {
	log {
		output file /var/log/caddy/glam.log
		format console
	}

	encode zstd gzip
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		X-Frame-Options "DENY"
		-Server
	}

	# Formularz „Umów pokaz”. Limit tempa i długości pól pilnuje usługa;
	# tu tylko ucinamy za duże zapytania, zanim dojdą do Node.
	handle /api/zgloszenie {
		request_body {
			max_size 8KB
		}
		reverse_proxy 127.0.0.1:3500 {
			header_up X-Real-IP {client_ip}
			header_up -X-Glam-Klucz
		}
	}

	# Panel zgłoszeń. Hasła i sesji pilnuje usługa; klucz mówi jej tylko, że
	# zapytanie przyszło przez Caddy, a nie wprost z portu na tej maszynie.
	@admin path /admin /admin/* /api/admin/*
	handle @admin {
		header Cache-Control "no-store"
		header X-Robots-Tag "noindex"
		request_body {
			max_size 8KB
		}
		reverse_proxy 127.0.0.1:3500 {
			header_up X-Real-IP {client_ip}
			import /etc/caddy/glam-klucz.caddy
		}
	}

	handle {
		root * /srv/glam-www
		# Strona HTML: przeglądarka zawsze pyta serwer, czy jest nowsza wersja
		# (bez zmian odpowiedź to krótkie 304), więc nowe wdrożenie widać od razu.
		@html path / *.html
		header @html Cache-Control "no-cache"
		# CSS i JS mają w index.html ?v=<skrót> (dopisuje wdroz.sh) – nowa treść
		# to nowy adres, więc można je trzymać długo.
		@wersja {
			path *.css *.js
			query v=*
		}
		header @wersja Cache-Control "public, max-age=31536000, immutable"
		# Obrazki i reszta bez wersji: krótki cache, nowa wersja najpóźniej po godzinie.
		@assets {
			path *.css *.js *.svg *.jpg *.png *.webp
			not query v=*
		}
		header @assets Cache-Control "public, max-age=3600"
		file_server
	}
}

www.glamcore.pl {
	log {
		output file /var/log/caddy/glam.log
		format console
	}
	redir https://glamcore.pl{uri} permanent
}
