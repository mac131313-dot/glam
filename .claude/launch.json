{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "api",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev",
        "-w",
        "@glam/api"
      ],
      "port": 3001,
      "autoPort": true
    },
    {
      "name": "web",
      "runtimeExecutable": "env",
      "runtimeArgs": [
        "API_PORT=3001",
        "npm",
        "run",
        "dev",
        "-w",
        "@glam/web"
      ],
      "port": 5173,
      "autoPort": true
    },
    {
      "name": "web-api3002",
      "runtimeExecutable": "env",
      "runtimeArgs": [
        "API_PORT=3002",
        "npm",
        "run",
        "dev",
        "-w",
        "@glam/web"
      ],
      "port": 5176,
      "autoPort": true
    },
    {
      "name": "web-win",
      "runtimeExecutable": "cmd",
      "runtimeArgs": ["/c", "set API_PORT=3002&& npm run dev -w @glam/web"],
      "port": 5173,
      "autoPort": true
    }
  ]
}